# انسخ هذا الملف إلى .env وغيّر كل القيم. لا ترفع .env لأي مستودع.
POSTGRES_PASSWORD=change-me-long-random
# 32 حرفاً على الأقل: يشفّر أسرار التحقق بخطوتين ويوقّع البصمات المؤقتة
SUMER_APP_SECRET=change-me-to-64-random-characters
# مفتاح تشفير النسخ الاحتياطية (AES-256-GCM). احفظه خارج الخادم؛ بدونه لا يمكن الاستعادة
SUMER_BACKUP_KEY=change-me-separate-random-key
SUMER_COOKIE_SECURE=1
# للتطوير المحلي فقط، ممنوع بالإنتاج:
# SUMER_ALLOW_PRIVATE_NETWORKS=0

# الدومين (للشهادة على VPS)
SUMER_DOMAIN=search.example.iq
